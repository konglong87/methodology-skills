{
  "name": "公众号配图主题配方",
  "description": "4套独立的CSS设计主题，用于生成公众号配图HTML页面。每套主题自成一体，不依赖外部skill。",
  "themes": {
    "linear": {
      "name": "暗黑风格",
      "nameEn": "Dark",
      "description": "深黑背景 + 紫色强调色，适合技术类、SaaS、开发者内容",
      "css": {
        "ground": "#08090A",
        "surface": "#16171C",
        "surface2": "#1E1F25",
        "surface3": "#26272E",
        "border": "rgba(255,255,255,0.06)",
        "borderStrong": "rgba(255,255,255,0.10)",
        "text": "#F7F8F8",
        "textSecondary": "#9CA3AF",
        "textMuted": "#6B7280",
        "accent": "#5E6AD2",
        "accentSoft": "rgba(94,106,210,0.12)",
        "accentGradient": "linear-gradient(135deg, #5E6AD2 0%, #7C6CF7 50%, #A78BFA 100%)",
        "heroGradient": "radial-gradient(ellipse 80% 60% at 50% 30%, rgba(94,106,210,0.10) 0%, transparent 70%)",
        "radiusSm": "6px",
        "radiusMd": "12px",
        "radiusLg": "16px",
        "shadowCard": "0 1px 2px rgba(0,0,0,0.3)",
        "shadowLg": "0 4px 16px rgba(0,0,0,0.4)",
        "fontDisplay": "'Inter Tight', 'Inter', -apple-system, sans-serif",
        "fontBody": "'Inter', -apple-system, sans-serif",
        "fontMono": "'JetBrains Mono', 'SF Mono', monospace",
        "displayWeight": "600",
        "bodySize": "15px",
        "bodyLineHeight": "1.55",
        "sectionGap": "80px",
        "transition": "0.30s cubic-bezier(0.22, 1, 0.36, 1)"
      }
    },
    "apple": {
      "name": "明亮风格",
      "nameEn": "Light",
      "description": "纯白背景 + 蓝色强调色，适合产品发布、品牌宣发",
      "css": {
        "ground": "#FFFFFF",
        "surface": "#F5F5F7",
        "surface2": "#FAFAFA",
        "surface3": "#F0F0F2",
        "border": "#D2D2D7",
        "borderStrong": "#C7C7CC",
        "text": "#1D1D1F",
        "textSecondary": "#6E6E73",
        "textMuted": "#86868B",
        "accent": "#0071E3",
        "accentSoft": "rgba(0,113,227,0.08)",
        "accentGradient": "linear-gradient(135deg, #0071E3 0%, #40A9FF 100%)",
        "heroGradient": "none",
        "radiusSm": "12px",
        "radiusMd": "18px",
        "radiusLg": "22px",
        "shadowCard": "0 1px 2px rgba(0,0,0,0.04)",
        "shadowLg": "0 2px 8px rgba(0,0,0,0.06)",
        "fontDisplay": "'Inter Tight', 'SF Pro Display', -apple-system, sans-serif",
        "fontBody": "'Inter', 'SF Pro Text', -apple-system, sans-serif",
        "fontMono": "'SF Mono', 'JetBrains Mono', monospace",
        "displayWeight": "600",
        "bodySize": "17px",
        "bodyLineHeight": "1.47",
        "sectionGap": "120px",
        "transition": "0.35s cubic-bezier(0.16, 1, 0.3, 1)"
      }
    },
    "stripe": {
      "name": "人文风格",
      "nameEn": "Warm",
      "description": "奶油色背景 + 赭色强调色 + 衬线字体，适合深度长文、人文内容",
      "css": {
        "ground": "#F1ECDE",
        "surface": "#E6DCC4",
        "surface2": "#EDE6D4",
        "surface3": "#DED4BA",
        "border": "#C8BEA4",
        "borderStrong": "#B8AE94",
        "text": "#1A1A18",
        "textSecondary": "#736D5A",
        "textMuted": "#9A947A",
        "accent": "#A04A2A",
        "accentSoft": "rgba(160,74,42,0.08)",
        "accentGradient": "linear-gradient(135deg, #A04A2A 0%, #C0633A 100%)",
        "heroGradient": "none",
        "radiusSm": "0px",
        "radiusMd": "0px",
        "radiusLg": "0px",
        "shadowCard": "0 1px 1px rgba(0,0,0,0.06)",
        "shadowLg": "0 24px 48px rgba(0,0,0,0.18)",
        "fontDisplay": "'Georgia', 'Times New Roman', serif",
        "fontBody": "'Georgia', 'Source Serif 4', 'Times New Roman', serif",
        "fontMono": "'SF Mono', monospace",
        "displayWeight": "400",
        "bodySize": "18px",
        "bodyLineHeight": "1.65",
        "sectionGap": "80px",
        "transition": "0.60s ease"
      }
    },
    "muji": {
      "name": "侘寂风格",
      "nameEn": "Zen",
      "description": "纸白背景 + 极简去色，适合生活方式、设计美学",
      "css": {
        "ground": "#F4F2EC",
        "surface": "#EBE8E0",
        "surface2": "#F0EDE6",
        "surface3": "#E5E2DA",
        "border": "#D9D6CD",
        "borderStrong": "#C8C5BC",
        "text": "#2A2A28",
        "textSecondary": "#7C7B76",
        "textMuted": "#A5A39C",
        "accent": "#C8161D",
        "accentSoft": "rgba(200,22,29,0.04)",
        "accentGradient": "none",
        "heroGradient": "none",
        "radiusSm": "0px",
        "radiusMd": "0px",
        "radiusLg": "0px",
        "shadowCard": "none",
        "shadowLg": "none",
        "fontDisplay": "'Inter Tight', 'Helvetica Neue', sans-serif",
        "fontBody": "'Inter', 'Helvetica Neue', sans-serif",
        "fontMono": "'SF Mono', monospace",
        "displayWeight": "400",
        "bodySize": "15px",
        "bodyLineHeight": "1.80",
        "sectionGap": "160px",
        "transition": "0.60s ease"
      }
    }
  },
  "screenshotDefaults": {
    "viewport": { "width": 750, "height": 1334 },
    "deviceScaleFactor": 2,
    "screenOverlap": 80,
    "sectionPaddingY": 64,
    "sectionPaddingX": 32
  },
  "sectionSelectors": [
    { "selector": ".hero", "label": "hero" },
    { "selector": ".pain-points, .problem", "label": "pain-points" },
    { "selector": ".features", "label": "features" },
    { "selector": ".how-it-works", "label": "how-it-works" },
    { "selector": ".showcase", "label": "showcase" },
    { "selector": ".use-cases", "label": "use-cases" },
    { "selector": ".stats", "label": "stats" },
    { "selector": ".pricing", "label": "pricing" },
    { "selector": ".faq", "label": "faq" },
    { "selector": ".cta-banner, .cta", "label": "cta" }
  ],
  "dependencies": {
    "playwright": "^1.60.0"
  }
}