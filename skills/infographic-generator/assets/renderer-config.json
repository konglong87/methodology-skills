{
  "renderer": {
    "name": "Infographic Renderer",
    "version": "2.0.0",
    "description": "信息图渲染工具配置 - 支持Retina输出"
  },
  "supported_formats": [
    "PNG",
    "SVG",
    "PDF",
    "WebP"
  ],
  "quality_presets": {
    "draft": {
      "label": "草稿",
      "scale": 1,
      "dpi": 72,
      "description": "快速预览"
    },
    "normal": {
      "label": "标准",
      "scale": 1,
      "dpi": 150,
      "description": "日常使用（默认）"
    },
    "professional": {
      "label": "专业",
      "scale": 2,
      "dpi": 300,
      "description": "高清输出"
    },
    "retina": {
      "label": "Retina",
      "scale": 3,
      "dpi": 300,
      "description": "超清输出"
    }
  },
  "rendering_engines": {
    "remotion": {
      "name": "Remotion",
      "description": "基于React的高质量渲染引擎",
      "supported_formats": ["PNG"],
      "supports_scale": true,
      "max_scale": 3,
      "advantages": [
        "组件化渲染",
        "支持Retina输出",
        "专业排版"
      ],
      "use_cases": [
        "知识科普信息图",
        "小红书爆款内容",
        "数据可视化",
        "高质量输出"
      ]
    },
    "html_puppeteer": {
      "name": "HTML+Puppeteer",
      "description": "HTML渲染后截图（降级方案，也支持Retina）",
      "supported_formats": ["PNG", "WebP"],
      "supports_scale": true,
      "max_scale": 3,
      "advantages": [
        "无需额外依赖",
        "支持自定义字体",
        "也支持Retina"
      ],
      "use_cases": [
        "Remotion不可用时降级",
        "快速原型"
      ]
    },
    "canvas": {
      "name": "Canvas API",
      "description": "使用HTML5 Canvas API进行渲染",
      "supported_formats": ["PNG"],
      "use_cases": [
        "数据可视化"
      ]
    },
    "svg": {
      "name": "SVG Renderer",
      "description": "生成SVG矢量图形",
      "supported_formats": ["SVG", "PNG"],
      "use_cases": [
        "技术文档",
        "流程图",
        "架构图"
      ]
    }
  },
  "output_config": {
    "PNG": {
      "default_width": 1920,
      "default_height": 1080,
      "default_dpi": 150,
      "supported_dpi": [72, 96, 150, 200, 300],
      "quality": "high",
      "compression": "balanced"
    }
  }
}
